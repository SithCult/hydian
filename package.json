{
  "name": "hydian",
  "private": true,
  "description": "Hydian — read-only roleplay companion and live map for Star Wars: The Old Republic",
  "license": "MIT",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "pnpm -C apps/desktop dev",
    "api": "pnpm -C apps/api dev",
    "web": "pnpm -C apps/web dev",
    "test:bridge": "node --test apps/desktop/dev-bridge/server.test.mjs",
    "test:desktop": "node --test apps/desktop/test/*.test.mjs",
    "test": "node --test scripts/release-version.test.mjs && pnpm test:bridge && pnpm test:desktop && pnpm -F @hydian/api test",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps/desktop/src apps/api/src apps/web/app apps/web/components apps/web/lib",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html,yml}\" .github",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html,yml}\" .github"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "4.135.0"
  },
  "type": "module"
}
